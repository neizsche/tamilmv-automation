# QBittorrent Configuration
QBITTORRENT_URL=http://192.168.1.100:8081
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=admin1

# Radarr Configuration
RADARR_URL=http://192.168.1.100:7878
RADARR_API_KEY=your-radarr-api-key
RADARR_ROOT_FOLDER=/path/to/movies
RADARR_QUALITY_PROFILE_ID=1


# RSS Feed Configuration
ENABLE_MALAYALAM_HD=true
ENABLE_HINDI_HD=true
ENABLE_TAMIL_HD=false
ENABLE_TELUGU_HD=false
ENABLE_KANNADA_HD=false
ENABLE_ENGLISH_HD=false

# Custom Feed Example (Uncomment to use)
# CUSTOM_FEED_NAME=my_custom_feed
# CUSTOM_FEED_PATH=forums/forum/123-custom-feed.xml

CHECK_INTERVAL_MINUTES=10

# Torrent Filter Settings
TORRENT_MIN_SIZE_GB=1
TORRENT_MAX_SIZE_GB=3

# QBittorrent Categories & Tags
QBITTORRENT_CATEGORY_ACTIVE=radarr
QBITTORRENT_CATEGORY_COMPLETED=completed
QBITTORRENT_TAG=tamilmv

# Scraping Settings
SCRAPING_MAX_RETRIES=5
SCRAPING_DELAY_MS=1000

# Notifications (optional)
NTFY_ENABLED=true
NTFY_TOPIC=tamilmv-movies
NTFY_SERVER=https://ntfy.sh